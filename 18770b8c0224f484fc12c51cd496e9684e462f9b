      },
      "writtenOn": "2026-06-01T16:50:13Z",
      "side": 1,
      "message": "Initially this app was only a daemon, which is why it\u0027s in libdir.\n\nMy preference would be to move to bindir without a subfolder",
      "parentUuid": "59c6967e_efee82c5",
      "revId": "18770b8c0224f484fc12c51cd496e9684e462f9b",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
    },
    {
      "unresolved": true,
