        "id": 1000000
      },
      "writtenOn": "2026-06-01T16:44:22Z",
      "side": 1,
      "message": "If we expect humans to call the CLI, it should go in `${bindir}`.  If we expect [typically] only to be call via service files and shell scripts, it should go in `${libexecdir}/${BPN}/`.",
      "parentUuid": "2b438474_1aa98102",
      "revId": "18770b8c0224f484fc12c51cd496e9684e462f9b",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
    },
    {
      "unresolved": true,
      "key": {
